# Copy to .env and fill with your token
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
PORT=3000
# LINE target to push weekly updates (one of these)
# Prefer LINE_TARGET_ID; can also use LINE_GROUP_ID or LINE_USER_ID
LINE_TARGET_ID=U89335c549c8d4ebb0d050da7b066fd6d
LINE_GROUP_ID=
LINE_USER_ID=U89335c549c8d4ebb0d050da7b066fd6d

# Optional: cron schedule and timezone for weekly push
# Default is every Monday 09:00 (Asia/Bangkok)
WEEKLY_CRON=0 9 * * 1
WEEKLY_TZ=Asia/Bangkok

# Optional: enable manual admin trigger endpoint
# Access with GET /admin/weekly-push?key=YOUR_KEY
ADMIN_KEY=

# Optional: public base URL for clickable links in replies
# Example: https://your-domain.example
PUBLIC_BASE_URL=
